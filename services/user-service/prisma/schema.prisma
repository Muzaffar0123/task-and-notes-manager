generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
  FROZEN
}

enum ProfileListVisibility {
  EVERYONE
  FOLLOWERS_ONLY
  ONLY_ME
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  bio          String   @default("") @db.VarChar(500)
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  status       AccountStatus @default(ACTIVE)
  tokenVersion Int      @default(0)
  followersVisibility ProfileListVisibility @default(EVERYONE)
  followingVisibility ProfileListVisibility @default(EVERYONE)
  profileImageKey         String?
  profileImageContentType String?
  profileImageSizeBytes   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserEventOutbox {
  id          String   @id @default(uuid())
  eventType   String
  userId      String
  payload     Json
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  attempts    Int      @default(0)

  @@index([publishedAt, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String
  action       String
  targetUserId String
  details      Json
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}
